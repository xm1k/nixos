+            && turn_context.auth_manager.as_deref().is_some_and(|auth| {
+                auth.current_auth_uses_codex_backend()
+                    || (is_ai_bnet && auth.get_api_auth_mode() == Some(AuthMode::ApiKey))
+            }))
