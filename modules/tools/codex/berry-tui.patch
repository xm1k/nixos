diff --git a/tui/src/berry.rs b/tui/src/berry.rs
new file mode 100644
index 0000000..83dfddd
--- /dev/null
+++ b/tui/src/berry.rs
@@ -0,0 +1,77 @@
+//! berry skin: the Claude Code look for the Codex TUI.
+//!
+//! Glyphs and colors shared by the restyled cells: `●` bullets, the `⎿` elbow
+//! (swapped in for `└` across the cells), the `✻` spinner of the status row and
+//! the blue pixel mascot of codex.b.net (`gitops/codex/static/codex.svg`, 18×10
+//! pixels, drawn here with half blocks as 9×5 cells).
+
+use std::time::Duration;
+
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+
+/// The mascot's blue (`#6CB6F0`), also the TUI accent.
+pub(crate) const MASCOT_RGB: (u8, u8, u8) = (0x6c, 0xb6, 0xf0);
+
+pub(crate) fn mascot_color() -> Color {
+    crate::terminal_palette::best_color(MASCOT_RGB)
+}
+
+/// Bullet of a finished tool call.
+pub(crate) fn done_bullet() -> Span<'static> {
+    "●".green()
+}
+
+/// Bullet of a failed tool call.
+pub(crate) fn failed_bullet() -> Span<'static> {
+    "●".red()
+}
+
+/// Bullet of the assistant's text.
+pub(crate) fn text_bullet() -> Span<'static> {
+    "● ".into()
+}
+
+/// `Tool(` … `)` header of a tool call, as Claude Code draws it.
+pub(crate) fn tool_title(name: &str) -> Vec<Span<'static>> {
+    vec![name.to_string().bold(), "(".into()]
+}
+
+/// The spinner of the status row: Claude Code's flower, there and back. `*`, not `✳`:
+/// U+2733 has an emoji form, and fonts draw it as a green emoji.
+const SPINNER: [&str; 6] = ["·", "✢", "*", "✶", "✻", "✽"];
+const SPINNER_FRAME: Duration = Duration::from_millis(120);
+
+pub(crate) fn spinner(elapsed: Duration) -> Span<'static> {
+    let cycle = SPINNER.len() * 2 - 2;
+    let step = (elapsed.as_millis() / SPINNER_FRAME.as_millis()) as usize % cycle;
+    let index = if step < SPINNER.len() { step } else { cycle - step };
+    Span::styled(SPINNER[index], Style::default().fg(mascot_color()))
+}
+
+/// The mascot, a little cloud with eyes: codex.svg's 18×10 pixels in quadrant blocks, two
+/// pixel rows per terminal row (as Claude Code's Clawd), so 9×3 cells.
+const MASCOT: [&str; 3] = [" ▄▛███▜▄ ", "▝███████▘", "  ▀   ▀  "];
+const MASCOT_GAP: &str = "   ";
+
+/// The welcome card: the mascot on the left and lines of text on its right (beyond three
+/// they continue under the text column).
+pub(crate) fn mascot_card(text: Vec<Line<'static>>) -> Vec<Line<'static>> {
+    let color = Style::default().fg(mascot_color());
+    let blank = " ".repeat(MASCOT[0].chars().count());
+    let rows = text.len().max(MASCOT.len());
+    let mut text = text.into_iter();
+    (0..rows)
+        .map(|row| {
+            let art = MASCOT.get(row).map_or(blank.clone(), |art| (*art).to_string());
+            let mut spans = vec![" ".into(), Span::styled(art, color), MASCOT_GAP.into()];
+            if let Some(line) = text.next() {
+                spans.extend(line.spans);
+            }
+            Line::from(spans)
+        })
+        .collect()
+}
