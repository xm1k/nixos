#!/usr/bin/env python3
"""netbox — быстрый поиск хостов из ansible inventory (NetBox) и ssh без ввода пароля.

Источники инвентаря (кешируется в ~/.cache/netbox-cli/inventory.json):
  * snapshot  — inventory_latest.yaml из artifactory (по умолчанию, токен не нужен)
  * live      — ansible-inventory -i $NB_INVENTORY_PATH --list (нужен NETBOX_TOKEN)
  * file      — локальный yaml/json, выгруженный через ansible-inventory

Переменные окружения:
  NB_SSH_PASS_VAR   имя переменной с паролем (по умолчанию WORK_PASS)
  NB_SSH_USER       пользователь для ssh (по умолчанию $WORK_ADMIN_USER, затем $USER)
  NB_INVENTORY_PATH путь к динамическому инвентарю для --live
                    (по умолчанию ~/work/rei_ansible_tools/inventory)
  NB_SNAPSHOT_URL   URL снапшота
  NB_CACHE_TTL      время жизни кеша в часах (по умолчанию 24, 0 — не обновлять сам)
  NB_SOURCE         источник для автообновления: snapshot|live (по умолчанию snapshot)
  NB_VERIFY_SSL     1 — проверять TLS-сертификат artifactory (по умолчанию не проверяется:
                    корпоративный self-signed CA)
"""

import argparse
import fnmatch
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

SNAPSHOT_URL = os.environ.get(
    "NB_SNAPSHOT_URL",
    "https://artifactory-nn.atmosphere.yadro.com/artifactory/re-infra-misc/inventory/inventory_latest.yaml",
)
INVENTORY_PATH = os.path.expanduser(
    os.environ.get("NB_INVENTORY_PATH", "~/work/rei_ansible_tools/inventory")
)
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser() / "netbox-cli"
CACHE_FILE = CACHE_DIR / "inventory.json"
CACHE_TTL_H = float(os.environ.get("NB_CACHE_TTL", "24"))
PASS_VAR = os.environ.get("NB_SSH_PASS_VAR", "WORK_PASS")
VERIFY_SSL = os.environ.get("NB_VERIFY_SSL", "") not in ("", "0", "false", "no")

SUBCOMMANDS = {"update", "ls", "list", "groups", "show", "ssh", "exec", "completion"}


def die(msg, code=1):
    print(f"netbox: {msg}", file=sys.stderr)
    sys.exit(code)


def tty_color(code, s):
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else s


# --------------------------------------------------------------------------- inventory parsing


def parse_inventory(data):
    """Привести yaml (дерево all.children...) или json (ansible-inventory --list) к виду
    {"hosts": {host: vars}, "groups": {group: {"hosts": [...], "children": [...]}}}."""
    hosts, groups = {}, {}

    if "_meta" in data:  # формат `ansible-inventory --list` (json)
        hosts = {h: v or {} for h, v in data["_meta"].get("hostvars", {}).items()}
        for g, body in data.items():
            if g == "_meta" or not isinstance(body, dict):
                continue
            groups[g] = {"hosts": list(body.get("hosts", [])), "children": list(body.get("children", []))}
            for h in body.get("hosts", []):
                hosts.setdefault(h, {})
        return {"hosts": hosts, "groups": groups}

    def walk(name, body):
        grp = groups.setdefault(name, {"hosts": [], "children": []})
        body = body or {}
        for h, hv in (body.get("hosts") or {}).items():
            hosts.setdefault(h, {}).update(hv or {})
            if h not in grp["hosts"]:
                grp["hosts"].append(h)
        for c, cb in (body.get("children") or {}).items():
            if c not in grp["children"]:
                grp["children"].append(c)
            walk(c, cb)

    for top, body in data.items():
        walk(top, body)
    return {"hosts": hosts, "groups": groups}


def load_text(text):
    text = text.lstrip()
    if text.startswith("{"):
        return json.loads(text)
    try:
        import yaml
    except ImportError:
        die("для yaml-инвентаря нужен PyYAML (pip install pyyaml)")

    class Loader(yaml.SafeLoader):
        pass

    # ansible-inventory --yaml пишет !unsafe / !vault — просто берём как строку
    Loader.add_multi_constructor("!", lambda loader, suffix, node: loader.construct_scalar(node)
                                 if isinstance(node, yaml.ScalarNode) else None)
    return yaml.load(text, Loader=Loader)


def fetch(source, path=None):
    if source == "file":
        return Path(path).read_text()
    if source == "snapshot":
        print(f"netbox: скачиваю {SNAPSHOT_URL}", file=sys.stderr)
        ctx = ssl.create_default_context() if VERIFY_SSL else ssl._create_unverified_context()
        with urllib.request.urlopen(SNAPSHOT_URL, timeout=60, context=ctx) as r:
            return r.read().decode()
    if source == "live":
        if not os.environ.get("NETBOX_TOKEN"):
            die("для --live нужен NETBOX_TOKEN")
        if not shutil.which("ansible-inventory"):
            die("ansible-inventory не найден")
        print(f"netbox: ansible-inventory -i {INVENTORY_PATH} --list (может занять пару минут)", file=sys.stderr)
        env = dict(os.environ, ANSIBLE_INVENTORY_UNPARSED_WARNING="False")
        if os.environ.get("NB_ALL_HOSTS"):
            env["ALL_HOSTS"] = "1"
        r = subprocess.run(["ansible-inventory", "-i", INVENTORY_PATH, "--list"],
                           capture_output=True, text=True, env=env)
        if r.returncode != 0:
            die("ansible-inventory упал:\n" + r.stderr)
        return r.stdout
    die(f"неизвестный источник {source}")


def update_cache(source, path=None):
    inv = parse_inventory(load_text(fetch(source, path)))
    inv["source"] = source if source != "file" else f"file:{path}"
    inv["updated"] = time.time()
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CACHE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(inv))
    tmp.replace(CACHE_FILE)
    return inv


def load_inventory(auto_update=True):
    inv = None
    if CACHE_FILE.exists():
        inv = json.loads(CACHE_FILE.read_text())
    stale = inv is None or (CACHE_TTL_H > 0 and time.time() - inv.get("updated", 0) > CACHE_TTL_H * 3600)
    if stale and auto_update:
        try:
            inv = update_cache(os.environ.get("NB_SOURCE", "snapshot"))
        except SystemExit:
            if inv is None:
                raise
        except Exception as e:  # noqa: BLE001
            if inv is None:
                die(f"не удалось получить инвентарь: {e}\nпопробуй: netbox update --live  или  netbox update --file inv.yaml")
            print(f"netbox: не удалось обновить кеш ({e}), использую старый", file=sys.stderr)
    return inv


# --------------------------------------------------------------------------- host model


class Inventory:
    def __init__(self, raw):
        self.hosts = raw["hosts"]
        self.groups = raw["groups"]
        self._members = {}
        self.host_groups = {h: set() for h in self.hosts}
        for g in self.groups:
            for h in self.members(g):
                self.host_groups.setdefault(h, set()).add(g)

    def members(self, group, _seen=None):
        if group in self._members:
            return self._members[group]
        _seen = _seen or set()
        if group in _seen or group not in self.groups:
            return set()
        _seen.add(group)
        g = self.groups[group]
        res = set(g["hosts"])
        for c in g["children"]:
            res |= self.members(c, _seen)
        self._members[group] = res
        return res

    def address(self, h):
        return self.hosts[h].get("ansible_host") or h

    def _resolve_term(self, term):
        """Один элемент ansible-паттерна: группа, хост, glob, ~regex."""
        if term in ("all", "*"):
            return set(self.hosts)
        if term.startswith("~"):
            rx = re.compile(term[1:])
            res = {h for h in self.hosts if rx.search(h)}
            for g in self.groups:
                if rx.search(g):
                    res |= self.members(g)
            return res
        if any(c in term for c in "*?["):
            res = {h for h in self.hosts if fnmatch.fnmatch(h, term)}
            for g in self.groups:
                if fnmatch.fnmatch(g, term):
                    res |= self.members(g)
            return res
        if term in self.groups:
            return set(self.members(term))
        if term in self.hosts:
            return {term}
        return set()

    def pattern(self, pat):
        """Ansible host pattern: 'a,b' — OR, ',&x' — AND, ',!x' — NOT."""
        terms = [t.strip() for t in re.split(r"[,:]", pat) if t.strip()]
        unknown = [t.lstrip("&!") for t in terms
                   if not self._resolve_term(t.lstrip("&!")) and t.lstrip("&!") not in self.groups]
        if unknown:
            print(f"netbox: в паттерне нет совпадений для: {', '.join(unknown)}", file=sys.stderr)
        base, inter, excl = set(), [], set()
        plain = False
        for t in terms:
            if t.startswith("&"):
                inter.append(self._resolve_term(t[1:]))
            elif t.startswith("!"):
                excl |= self._resolve_term(t[1:])
            else:
                plain = True
                base |= self._resolve_term(t)
        if not plain:
            base = set(self.hosts)
        for s in inter:
            base &= s
        return base - excl

    def search(self, queries, group_pattern=None):
        """Хосты, где каждый query — подстрока (или glob) имени/IP/группы."""
        cand = self.pattern(group_pattern) if group_pattern else set(self.hosts)
        for q in queries:
            q = q.lower()
            is_glob = any(c in q for c in "*?[")

            def ok(h):
                fields = [h.lower(), str(self.address(h)).lower()]
                if is_glob:
                    return any(fnmatch.fnmatch(f, q) for f in fields)
                return any(q in f for f in fields) or q in {g.lower() for g in self.host_groups.get(h, ())}

            cand = {h for h in cand if ok(h)}
        return sorted(cand)

    def interesting_groups(self, h):
        skip = ("all", "ungrouped", "status_", "is_virtual", "device_types_", "tags_atmosphere")
        return sorted(g for g in self.host_groups.get(h, ()) if not g.startswith(skip))


# --------------------------------------------------------------------------- output


def print_hosts(inv, hosts, long=False):
    if not hosts:
        return
    w = max(len(h) for h in hosts)
    for h in hosts:
        if long:
            addr = inv.address(h)
            groups = ",".join(inv.interesting_groups(h))
            print(f"{tty_color('1', h.ljust(w))}  {str(addr).ljust(15)}  {tty_color('2', groups)}")
        else:
            print(h)


def pick(inv, hosts):
    """Выбрать один хост из нескольких: fzf если есть, иначе нумерованное меню."""
    if len(hosts) == 1:
        return hosts[0]
    if not sys.stdin.isatty():
        die("найдено несколько хостов, уточни запрос:\n  " + "\n  ".join(hosts))
    lines = [f"{h}\t{inv.address(h)}\t{','.join(inv.interesting_groups(h))}" for h in hosts]
    if shutil.which("fzf"):
        r = subprocess.run(["fzf", "--height=40%", "--reverse", "--delimiter=\t", "--with-nth=1,2,3"],
                           input="\n".join(lines), capture_output=False, stdout=subprocess.PIPE, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            sys.exit(130)
        return r.stdout.split("\t", 1)[0]
    w = max(len(h) for h in hosts)
    for i, h in enumerate(hosts, 1):
        print(f"{tty_color('33', str(i).rjust(3))}) {h.ljust(w)}  {inv.address(h)}  "
              f"{tty_color('2', ','.join(inv.interesting_groups(h)))}", file=sys.stderr)
    try:
        ans = input("номер (или текст для сужения): ").strip()
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        sys.exit(130)
    if ans.isdigit() and 1 <= int(ans) <= len(hosts):
        return hosts[int(ans) - 1]
    narrowed = [h for h in hosts if ans.lower() in h.lower()] if ans else []
    if not narrowed:
        die("ничего не выбрано")
    return pick(inv, narrowed)


# --------------------------------------------------------------------------- ssh


def ssh_env():
    if not os.environ.get(PASS_VAR):
        print(f"netbox: переменная {PASS_VAR} пуста — ssh спросит пароль сам", file=sys.stderr)
        return dict(os.environ)
    env = dict(os.environ)
    # ssh сам вызовет этот же скрипт как askpass, тот напечатает пароль из env
    env["SSH_ASKPASS"] = os.path.realpath(__file__)
    env["SSH_ASKPASS_REQUIRE"] = "force"
    env["NB_ASKPASS_MODE"] = "1"
    env.setdefault("DISPLAY", ":0")  # старые ssh без DISPLAY askpass не зовут
    return env


def askpass_main():
    prompt = " ".join(sys.argv[1:]).lower()
    # отвечаем только на запрос пароля — не на yes/no про host key и т.п.
    if not any(w in prompt for w in ("yes/no", "fingerprint", "passphrase")):
        pw = os.environ.get(PASS_VAR)
        if pw:
            print(pw)
            return 0
    return 1


def ssh_cmd(inv, host, user, extra):
    addr = inv.address(host)
    cmd = ["ssh",
           "-o", "StrictHostKeyChecking=accept-new",
           "-o", "PreferredAuthentications=keyboard-interactive,password,publickey",
           "-o", "NumberOfPasswordPrompts=1",
           f"{user}@{addr}" if user else str(addr)]
    if addr != host:
        cmd[1:1] = ["-o", f"HostKeyAlias={host}"]
    return cmd + list(extra)


def default_user(args_user):
    return (args_user or os.environ.get("NB_SSH_USER") or os.environ.get("WORK_ADMIN_USER")
            or os.environ.get("USER"))


# --------------------------------------------------------------------------- commands


def cmd_update(args):
    try:
        if args.file:
            inv = update_cache("file", args.file)
        else:
            inv = update_cache("live" if args.live else "snapshot")
    except (OSError, ValueError) as e:
        die(f"не удалось обновить инвентарь: {e}")
    print(f"netbox: {len(inv['hosts'])} хостов, {len(inv['groups'])} групп -> {CACHE_FILE}", file=sys.stderr)


def cmd_ls(args):
    inv = Inventory(load_inventory())
    hosts = inv.search(args.query, args.group)
    print_hosts(inv, hosts, long=not args.short)
    if sys.stdout.isatty():
        print(tty_color("2", f"-- {len(hosts)} хостов"), file=sys.stderr)


def cmd_groups(args):
    inv = Inventory(load_inventory())
    for g in sorted(inv.groups):
        if args.filter and args.filter.lower() not in g.lower():
            continue
        print(f"{g.ljust(50)} {len(inv.members(g))}")


def cmd_show(args):
    inv = Inventory(load_inventory())
    h = pick(inv, inv.search(args.query, args.group) or die("ничего не найдено"))
    print(tty_color("1", h))
    print(f"  address: {inv.address(h)}")
    print(f"  groups:  {', '.join(sorted(inv.host_groups.get(h, ())))}")
    keys = [k for k in sorted(inv.hosts[h]) if args.all or not k.startswith(("ansible_", "vector", "fluentbit", "node_exporter", "cadvisor"))]
    for k in keys:
        v = inv.hosts[h][k]
        s = json.dumps(v, ensure_ascii=False) if not isinstance(v, str) else v
        if len(s) > 200 and not args.all:
            s = s[:200] + "…"
        print(f"  {k}: {s}")


def cmd_ssh(args):
    inv = Inventory(load_inventory())
    hosts = inv.search(args.query, args.group)
    if not hosts:
        die(f"ничего не найдено по запросу: {' '.join(args.query)} {args.group or ''}")
    host = pick(inv, hosts)
    cmd = ssh_cmd(inv, host, default_user(args.user), args.ssh_args)
    print(tty_color("2", f"-> {host} ({inv.address(host)})"), file=sys.stderr)
    os.execvpe("ssh", cmd, ssh_env())


def cmd_exec(args):
    inv = Inventory(load_inventory())
    hosts = inv.search(args.query, args.group)
    if not hosts:
        die("ничего не найдено")
    if not args.command:
        die("укажи команду после --")
    if not args.yes and sys.stdin.isatty():
        print_hosts(inv, hosts)
        if input(f"выполнить на {len(hosts)} хостах? [y/N] ").strip().lower() not in ("y", "yes", "д", "да"):
            sys.exit(1)
    env = ssh_env()
    user = default_user(args.user)
    rc = 0
    remote = " ".join(args.command)

    def run(h):
        return h, subprocess.run(ssh_cmd(inv, h, user, ["-o", "BatchMode=no", "-T", remote]),
                                 env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True)

    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=args.forks) as ex:
        for h, r in ex.map(run, hosts):
            status = tty_color("32", "ok") if r.returncode == 0 else tty_color("31", f"rc={r.returncode}")
            print(f"{tty_color('1', h)} | {status}")
            out = (r.stdout + r.stderr).rstrip()
            if out:
                print("\n".join("    " + l for l in out.splitlines()))
            rc = rc or r.returncode
    sys.exit(rc)


def cmd_completion(args):
    print(r'''# eval "$(netbox completion)"
_netbox_complete() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "update ls groups show ssh exec completion $(netbox ls -s 2>/dev/null)" -- "$cur"))
    elif [[ ${COMP_WORDS[COMP_CWORD-1]} == -g ]]; then
        COMPREPLY=($(compgen -W "$(netbox groups 2>/dev/null | cut -d' ' -f1)" -- "$cur"))
    else
        COMPREPLY=($(compgen -W "$(netbox ls -s 2>/dev/null)" -- "$cur"))
    fi
}
complete -F _netbox_complete netbox''')


def build_parser():
    p = argparse.ArgumentParser(
        prog="netbox",
        description="Поиск хостов из NetBox-инвентаря и ssh без пароля. "
                    "`netbox <запрос>` == `netbox ssh <запрос>`.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""примеры:
  netbox update                     обновить кеш из artifactory-снапшота
  netbox update --live              обновить через ansible-inventory (нужен NETBOX_TOKEN)
  netbox ls kub nn                  хосты, где есть 'kub' и 'nn'
  netbox ls -g 'region_nn,&k8s,!env_prod'
  netbox nnpkub0044                 ssh на хост (подстрока, при нескольких — выбор)
  netbox ssh -g k8s_nn_prod         выбрать из группы и зайти
  netbox ssh kub0044 -- uptime      выполнить команду
  netbox exec -g k8s_spb_prod -- 'uptime'   команда на всех хостах группы
""")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("update", help="обновить кеш инвентаря")
    s.add_argument("--live", action="store_true", help="через ansible-inventory + NETBOX_TOKEN")
    s.add_argument("--file", help="загрузить из локального yaml/json")
    s.set_defaults(func=cmd_update)

    def add_query(sp):
        sp.add_argument("query", nargs="*", help="подстроки/glob по имени, IP или группе (все должны совпасть)")
        sp.add_argument("-g", "--group", help="ansible-паттерн: 'region_nn,&k8s,!env_prod'")

    s = sub.add_parser("ls", aliases=["list"], help="найти хосты")
    add_query(s)
    s.add_argument("-s", "--short", action="store_true", help="только имена")
    s.set_defaults(func=cmd_ls)

    s = sub.add_parser("groups", help="список групп")
    s.add_argument("filter", nargs="?")
    s.set_defaults(func=cmd_groups)

    s = sub.add_parser("show", help="переменные хоста")
    add_query(s)
    s.add_argument("-a", "--all", action="store_true", help="все переменные без сокращений")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("ssh", help="зайти на хост")
    add_query(s)
    s.add_argument("-u", "--user")
    s.set_defaults(func=cmd_ssh)

    s = sub.add_parser("exec", help="выполнить команду на всех найденных хостах")
    add_query(s)
    s.add_argument("-u", "--user")
    s.add_argument("-f", "--forks", type=int, default=10)
    s.add_argument("-y", "--yes", action="store_true", help="не спрашивать подтверждение")
    s.set_defaults(func=cmd_exec)

    s = sub.add_parser("completion", help="bash completion: eval \"$(netbox completion)\"")
    s.set_defaults(func=cmd_completion)
    return p


def main(argv):
    if os.environ.get("NB_ASKPASS_MODE"):
        sys.exit(askpass_main())

    # всё после `--` — команда для ssh/exec
    tail = []
    if "--" in argv:
        i = argv.index("--")
        argv, tail = argv[:i], argv[i + 1:]
    if argv and argv[0] not in SUBCOMMANDS and not argv[0].startswith("-"):
        argv = ["ssh"] + argv
    if not argv:
        argv = ["ls"]

    args = build_parser().parse_args(argv)
    args.ssh_args = tail
    args.command = tail
    if not hasattr(args, "func"):
        build_parser().print_help()
        return
    args.func(args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        pass
